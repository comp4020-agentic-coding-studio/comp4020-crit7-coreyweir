---
import "../styles.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const here = Astro.url.pathname;
const links = [
  { href: "/", label: "Request an extension" },
  { href: "/requests/", label: "My requests" },
  { href: "/profile/", label: "My EAP & defaults" },
  { href: "/readme/", label: "About" },
];
const current = (href: string) =>
  href === "/" ? here === "/" : here.startsWith(href) ? "page" : undefined;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · ANU extension requests</title>
  </head>
  <body>
    <nav aria-label="site">
      {
        links.map((l) => (
          <a href={l.href} aria-current={current(l.href) ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
